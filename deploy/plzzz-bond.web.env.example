# Copy into a private environment file or your host's secret configuration.
# These placeholders deliberately cannot activate production.
NODE_ENV=production
HUSKY=0
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_NETWORK=mainnet-beta
NEXT_PUBLIC_SITE_URL=https://plzzz.bond
NEXT_PUBLIC_DEMO_LAUNCHES=false
LAUNCH_POLICY_VERSION=bond-v1
RPC_URL=REPLACE_WITH_PRIVATE_MAINNET_HTTPS_RPC
PINATA_JWT=REPLACE_WITH_RESTRICTED_PINATA_JWT
DATABASE_URL=REPLACE_WITH_PRODUCTION_POSTGRES_URL
DATABASE_SSL_CA=REPLACE_WITH_VERIFIED_CA_PATH_IF_NOT_SYSTEM_CA
POOL_CONFIG_KEY=REPLACE_WITH_DEPLOYED_BOND_CONFIG_ADDRESS
NEXT_PUBLIC_POOL_CONFIG_KEY=REPLACE_WITH_SAME_DEPLOYED_BOND_CONFIG_ADDRESS
LEGACY_POOL_CONFIG_KEYS=
FEE_COLLECTOR_PUBLIC_KEY=3j4vUdPKF7HNqKoaWdezQoX9Hognn6Us7ua6thZZiaed
TREASURY_PUBLIC_KEY=GfgpgQa2ZqNm17rJ6fw2t5nBApKKPZBn5M5niWW3riZZ
IPFS_GATEWAY_URL=https://gateway.pinata.cloud
SITE_ALLOWED_ORIGINS=
WHITELIST_ENABLED=true
NEXT_PUBLIC_WHITELIST_ENABLED=true
WHITELIST_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Choose these privately with scripts/setup-admin.mjs. Never put a raw admin key here.
ADMIN_KEY_HASH=
# Required even without admin sign-in: it protects saved launch recovery receipts.
ADMIN_SESSION_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_RECOVERY_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_SESSION_EPOCH=0
ADMIN_SESSION_NOT_BEFORE_MS=0
# Keep the public web process separate from the private financial operator.
WALLET_WORKER_ENABLED=false
FINANCIAL_WORKER_ENABLED=false
LOCAL_VALIDATOR_ENABLED=false
# Open only after the release sequence in docs/LIVE-DEPLOYMENT.md.
LAUNCHPAD_PUBLIC=false
MAINNET_TRADING_ENABLED=false
