{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fun-launch",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@meteora-invent/scaffold/fun-launch",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "fun-launch-open",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@meteora-invent/scaffold/fun-launch",
        "dev"
      ],
      "env": {
        "LAUNCHPAD_PUBLIC": "true",
        "NEXT_PUBLIC_SITE_URL": "http://localhost:3000"
      },
      "port": 3000
    },
    {
      "name": "fun-launch-demo",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@meteora-invent/scaffold/fun-launch",
        "dev"
      ],
      "env": {
        "LAUNCHPAD_PUBLIC": "true",
        "NEXT_PUBLIC_SITE_URL": "http://localhost:3000",
        "NEXT_PUBLIC_DEMO_LAUNCHES": "true",
        "NEXT_PUBLIC_NETWORK": "devnet"
      },
      "port": 3000
    }
  ]
}
