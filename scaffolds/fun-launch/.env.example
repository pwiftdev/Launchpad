# IPFS via Pinata (app.pinata.cloud -> API Keys -> New Key -> copy the JWT)
PINATA_JWT=your_pinata_jwt
# Optional: gateway used in metadata URLs. Defaults to https://gateway.pinata.cloud; a Pinata dedicated gateway (https://<name>.mypinata.cloud) is faster
IPFS_GATEWAY_URL=https://gateway.pinata.cloud

# Mainnet early-access registration (never expose these server secrets in NEXT_PUBLIC variables)
WHITELIST_ENABLED=false
LAUNCHPAD_PUBLIC=false
NEXT_PUBLIC_WHITELIST_ENABLED=false
DATABASE_URL=
WHITELIST_SECRET=
# For external Postgres clients: path to the verified AWS RDS CA bundle.
# Heroku uses the stack's system CA bundle automatically.
DATABASE_SSL_CA=
# Mainnet trading is disabled until an explicitly reviewed wallet deployment is enabled.
MAINNET_TRADING_ENABLED=false

# The launchpad is private by default. Empty admin credentials keep it locked for everyone.
# Choose your key privately with: node scripts/setup-admin.mjs (from the repository root).
# Never use NEXT_PUBLIC variables for admin credentials and never store the raw key here.
ADMIN_KEY_HASH=
# Required for Bond it. launch recovery even when no admin sign-in key is configured.
ADMIN_SESSION_SECRET=
# Set a NEW unique non-secret epoch and restart all web instances to revoke all sessions.
ADMIN_SESSION_EPOCH=0
# Optional Unix timestamp in milliseconds; reject sessions issued before this cutoff.
ADMIN_SESSION_NOT_BEFORE_MS=0

# Solana RPC URL
RPC_URL=your_rpc_url
# Optional server-only Mobula key for public market summaries on mainnet.
MOBULA_API_KEY=
# Log aggregate web RPC method counts every minute, with no request parameters.
RPC_USAGE_LOG=false
# devnet | mainnet-beta. The mainnet flag above defaults to false.
NEXT_PUBLIC_NETWORK=devnet
# Canonical origin, also used for wallet authorization. No trailing slash.
# On Heroku use https://<app-name>.herokuapp.com or your custom domain; rebuild after changes.
NEXT_PUBLIC_SITE_URL=https://plzzz.bond
# Optional additional exact HTTPS origins (comma-separated), e.g. https://plzzz.bond.
# Keep NEXT_PUBLIC_SITE_URL a single canonical origin.
SITE_ALLOWED_ORIGINS=
# Optional design preview: 25 labeled, non-tradable sample launches. Devnet only; rebuild to change.
NEXT_PUBLIC_DEMO_LAUNCHES=false

# Pool Configuration
POOL_CONFIG_KEY=your_pool_config_key
# Same active config key, exposed to the browser.
NEXT_PUBLIC_POOL_CONFIG_KEY=your_pool_config_key
# Earlier configurations stay discoverable without becoming eligible for new launches.
LEGACY_POOL_CONFIG_KEYS=

# Bond it. public company recipients. These are public addresses, never signing keys.
LAUNCH_POLICY_VERSION=bond-v1
FEE_COLLECTOR_PUBLIC_KEY=
TREASURY_PUBLIC_KEY=
# The private unsigned operator uses a separate hosting package and database configuration.
# Keep signer command, private key file and signer policy settings out of the public web process.
WALLET_WORKER_ENABLED=false
# Read-only public web monitor latency threshold, in milliseconds.
WEB_HEALTH_SLOW_MS=1500

# Isolated rehearsal only: rejected in production, even when enabled.
# NEXT_PUBLIC_NETWORK=localnet
LOCAL_VALIDATOR_ENABLED=false
LOCAL_VALIDATOR_GENESIS_HASH=
NEXT_PUBLIC_LOCAL_VALIDATOR_RPC_URL=
