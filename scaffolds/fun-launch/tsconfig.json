{
  "extends": "@meteora-invent/config/typescript/nextjs",
  "compilerOptions": {
    "target": "ES2020",
    "paths": {
      "@/*": ["./src/*"]
    },
    "composite": false,
    "noEmit": true,
    "strictNullChecks": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
